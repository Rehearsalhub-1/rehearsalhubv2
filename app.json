{
  "expo": {
    "name": "Rehearsal Hub Portal",
    "slug": "rehearsal-hub-portal",
    "scheme": "rehearsalhub",
    "version": "2.1.1",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "UIBackgroundModes": [
          "audio",
          "voip"
        ],
        "NSMicrophoneUsageDescription": "RehearsalHub needs microphone access for voice and video calls",
        "NSCameraUsageDescription": "RehearsalHub needs camera access for video calls",
        "NSPhotoLibraryUsageDescription": "RehearsalHub needs access to your photo library to select and upload photos and profile images",
        "NSPhotoLibraryAddUsageDescription": "RehearsalHub needs access to save photos to your photo library",
        "ITSAppUsesNonExemptEncryption": false
      },
      "bundleIdentifier": "com.karaoke.rehearsalhubv2",
      "associatedDomains": [
        "applinks:www.loveworldsingersrehearsalhubportal.org"
      ]
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "softwareKeyboardLayoutMode": "resize",
      "predictiveBackGestureEnabled": false,
      "package": "com.karaoke.rehearsalhubv2",
      "permissions": [
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK",
        "android.permission.WAKE_LOCK",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.USE_FULL_SCREEN_INTENT",
        "android.permission.RECORD_AUDIO",
        "android.permission.CAMERA"
      ],
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "www.loveworldsingersrehearsalhubportal.org",
              "pathPrefix": "/songs"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        },
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "rehearsalhub.net",
              "pathPrefix": "/"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-asset",
      "expo-font",
      "expo-video",
      "expo-web-browser",
      "expo-secure-store",
      [
        "expo-updates",
        {
          "launchWaitMs": 0
        }
      ],
      "./plugins/withKotlinJvmTarget",
      "expo-image",
      "expo-sharing",
      "expo-splash-screen",
      "expo-status-bar",
      "expo-audio"
    ],
    "extra": {
      "eas": {
        "projectId": "e98f38ac-ca86-4999-aa48-083199465371"
      }
    },
    "owner": "hub11",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/e98f38ac-ca86-4999-aa48-083199465371",
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 0
    }
  }
}
